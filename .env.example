# ─────────────────────────────────────────────────────────────
# HAJZI environment variables — PLACEHOLDERS ONLY.
# Copy to .env.local (never commit it) and fill in real values.
# Only NEXT_PUBLIC_* values are sent to the browser — never put secrets in them.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (SEO, Open Graph, sitemap, CSRF origin check)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED in production: PostgreSQL connection (Supabase → Connect → "Transaction pooler" URI, port 6543).
# Stores fields, bookings, accounts, photos and rate limits. Leave empty locally to use ./data/db.json.
# Prepare the database once with:  npm run db:setup
DATABASE_URL=

# REQUIRED in production: 32+ random characters. Encrypts 2FA secrets and salts hashed IPs in logs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-48-random-bytes

# Admin session lifetime in hours (default 8)
SESSION_MAX_AGE_HOURS=8

# Optional first-admin bootstrap (used only while no users exist — handy on hosts without a shell).
# Put a bcrypt HASH here, never a plain password:  npm run user:create -- --hash-only
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# One-time code that unlocks the staff "Create account" page (/admin/setup). Leave empty to disable it.
ADMIN_SETUP_CODE=

# Cloudflare Turnstile (bot protection on booking + contact forms). Free at dash.cloudflare.com.
# Leave empty to disable locally. Cloudflare test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Upstash Redis for rate limits. Not needed when DATABASE_URL is set (rate limits then use the database).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Abuse limits
MAX_BOOKINGS_PER_PHONE_PER_DAY=2
MAX_ACTIVE_BOOKINGS_PER_PHONE=4

# Privacy: anonymise bookings / delete logs after N months
BOOKING_RETENTION_MONTHS=12

# Local-only storage locations when DATABASE_URL is empty (defaults: ./data/db.json and ./data/uploads)
# HAJZI_DATA_FILE=./data/db.json
# HAJZI_UPLOAD_DIR=./data/uploads
