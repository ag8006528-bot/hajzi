{
  "name": "hajzi",
  "version": "1.1.0",
  "private": true,
  "description": "HAJZI — football field reservation platform",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/unit/*.test.mts",
    "test:security": "tsx --test tests/integration/*.test.mts",
    "user:create": "tsx --conditions=react-server scripts/create-user.ts",
    "demo:reset-fields": "tsx --conditions=react-server scripts/reset-demo-fields.ts",
    "db:setup": "tsx --conditions=react-server scripts/db-setup.ts",
    "deploy:secrets": "tsx scripts/deploy-secrets.ts",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^11.18.2",
    "next": "^15.5.7",
    "postgres": "^3.4.9",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
